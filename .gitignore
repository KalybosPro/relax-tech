# Dart / Flutter
.dart_tool/
.packages
build/
# …but keep source directories literally named "build" under lib/ (e.g. the
# relax_cli `build` command). Only build OUTPUT should be ignored.
!packages/**/lib/**/build/
!packages/**/lib/**/build/**
.pub-cache/
.pub/
pubspec_overrides.yaml

# Workspace-wide lockfile is committed; per-package lockfiles are not needed
# for libraries (only the workspace root resolves dependencies).
packages/*/pubspec.lock

# IDE
.idea/
.vscode/
*.iml
marketing
.claude/

# OS
.DS_Store
Thumbs.db

# Flutter ephemeral
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.fvm/

# Workspace root lockfile (regenerated by dart pub get)
/pubspec.lock
